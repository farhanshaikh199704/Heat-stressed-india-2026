library(sf)
library(dplyr)
library(leaflet)
library(htmlwidgets)
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
library(here)
hri <- read.csv(here("data", "ceew_district_hri.csv"))
districts <- st_read(here("data", "india_districts.geojson"))
districts_joined <- districts %>%
left_join(
hri %>% select(district_upper, state_upper,
hri_normalised, hri_category),
by = c("district_upper" = "district_upper",
"state_upper" = "state_upper")
)
districts$district_upper <- toupper(districts$district)
districts$state_upper <- toupper(districts$state)
hri$district_upper <- toupper(hri$district)
hri$state_upper <- toupper(hri$state)
districts_joined <- districts %>%
left_join(
hri %>% select(district_upper, state_upper,
hri_normalised, hri_category),
by = c("district_upper" = "district_upper",
"state_upper" = "state_upper")
)
pal <- colorNumeric(
palette = c("#E6F1FB","#FAC775","#EF9F27","#D85A30","#993C1D"),
domain = c(0, 1),
na.color = "#cccccc"
)
map <- leaflet(districts_joined) %>%
addProviderTiles(providers$CartoDB.Positron) %>%
setView(lng = 80, lat = 22, zoom = 5) %>%
addPolygons(
fillColor = ~pal(hri_normalised),
fillOpacity = 0.8,
color = "#ffffff",
weight = 0.5,
label = ~ifelse(
is.na(hri_normalised),
paste0(district, ", ", state, " — data not available"),
paste0(district, ", ", state,
" — HRI: ", round(hri_normalised, 3),
" (", hri_category, ")")
),
highlightOptions = highlightOptions(
weight = 2, color = "#333", fillOpacity = 0.95
)
) %>%
addLegend(
pal = pal,
values = ~hri_normalised,
title = "Heat Risk Index",
position = "bottomright",
labFormat = labelFormat(digits = 2)
)
saveWidget(map, "visual1-map.html", selfcontained = TRUE)
cat("Map saved\n")
